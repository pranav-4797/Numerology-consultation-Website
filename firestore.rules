rules_version = '2';

service cloud.firestore {
  // Helper function to check admin custom claim
  function isAdmin() {
    return request.auth != null && request.auth.token.admin == true;
  }

  // Helper to validate allowed fields for each collection
  function hasOnlyAllowedFields(allowed) {
    return request.resource.data.keys().hasOnly(allowed);
  }

  match /databases/{database}/documents {
    // Public read for most collections
    match /blogs/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /services/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /workshops/{workshopId} {
      allow read: if true;
      // Admin can create/delete/update freely. Public can only decrement availableSeats by 1.
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableSeats']) &&
        request.resource.data.availableSeats == resource.data.availableSeats - 1 &&
        resource.data.availableSeats > 0
      );
    }
    match /events/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /testimonials/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /gallery/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /siteSettings/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Products catalogue - public read, admin-only write
    match /products/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Special Offers - public read, admin-only write
    match /offers/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    // Contact form submissions: anyone can create, admin can read/update/delete
    match /contacts/{contactId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.email is string &&
        request.resource.data.message is string &&
        request.resource.data.name.size() <= 200 &&
        request.resource.data.message.size() <= 5000 &&
        hasOnlyAllowedFields(['name','phone','email','message','createdAt','status','notes','followUpDate']);
    }
    // Appointment bookings
    match /appointments/{appointmentId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.email is string &&
        request.resource.data.date is string &&
        request.resource.data.timeSlot is string &&
        request.resource.data.status == 'pending' &&
        request.resource.data.paid == false &&
        request.resource.data.name.size() <= 200 &&
        hasOnlyAllowedFields(['name','phone','email','serviceId','serviceTitle','fees','date','timeSlot','birthdate','personalityNumber','destinyNumber','zodiacSign','message','status','paid','createdAt']);
    }
    // Workshop registrations
    match /registrations/{registrationId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.email is string &&
        request.resource.data.workshopId is string &&
        request.resource.data.status == 'registered' &&
        request.resource.data.paid == false &&
        request.resource.data.name.size() <= 200 &&
        hasOnlyAllowedFields(['workshopId','workshopTitle','name','phone','email','status','paid','createdAt']);
    }
    // Orders
    match /orders/{orderId} {
      allow read, update, delete: if isAdmin();
      allow create: if
        request.resource.data.name is string &&
        request.resource.data.phone is string &&
        request.resource.data.address is string &&
        request.resource.data.district is string &&
        request.resource.data.state is string &&
        request.resource.data.pincode is string &&
        request.resource.data.total is number &&
        request.resource.data.status == 'pending' &&
        hasOnlyAllowedFields(['name','phone','email','address','district','state','pincode','items','subtotal','shippingCharges','total','status','createdAt']);
    }
    // Default deny all other writes
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}

// Storage rules (images only, admin upload)
service firebase.storage {
  match /b/{bucket}/o {
    // Allow read of any file
    match /{allPaths=**} {
      allow read: if true;
    }
    // Allow write only for admin users and only image files up to 5MB
    match /images/{fileName} {
      allow write: if request.auth != null && request.auth.token.admin == true && request.resource.size < 5 * 1024 * 1024 && request.resource.contentType.matches('image/.*');
    }
  }
}
